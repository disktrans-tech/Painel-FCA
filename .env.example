# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" NUNCA é commitado (já está no .gitignore).
# Nenhum valor real deve ficar neste arquivo — apenas exemplos/placeholders.

# ---------------------------------------------------------
# Banco de dados (Supabase / Postgres)
# ---------------------------------------------------------
DB_HOST=coloque-o-host-aqui.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=coloque-o-usuario-aqui
DB_PASSWORD=coloque-a-senha-aqui
# String de conexão completa (alternativa às variáveis separadas acima)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Se o projeto usar a API do Supabase (auth, storage, etc.) além do Postgres direto:
SUPABASE_URL=https://coloque-o-projeto-aqui.supabase.co
SUPABASE_ANON_KEY=coloque-a-chave-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=coloque-a-chave-de-servico-aqui

# ---------------------------------------------------------
# API / Backend
# ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Origem(ns) do frontend que podem chamar a API (CORS), separadas por vírgula
API_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Ambiente: local | homologacao | producao
AMBIENTE=local

# ---------------------------------------------------------
# Outras integrações do projeto (exemplos — remova o que não usar)
# ---------------------------------------------------------
# N8N_WEBHOOK_URL=
# API_TOKEN_TERCEIRO=
