# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" NUNCA é commitado (já está no .gitignore).
# Nenhum valor real deve ficar neste arquivo — apenas exemplos/placeholders.

# ---------------------------------------------------------
# Banco de dados (Supabase / Postgres)
# ---------------------------------------------------------
DB_HOST=coloque-o-host-aqui.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=coloque-o-usuario-aqui
DB_PASSWORD=coloque-a-senha-aqui
# String de conexão completa (alternativa às variáveis separadas acima)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Se o projeto usar a API do Supabase (auth, storage, etc.) além do Postgres direto:
SUPABASE_URL=https://coloque-o-projeto-aqui.supabase.co
SUPABASE_ANON_KEY=coloque-a-chave-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=coloque-a-chave-de-servico-aqui

# ---------------------------------------------------------
# API / Backend
# ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Origem(ns) do frontend que podem chamar a API (CORS), separadas por vírgula
API_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Ambiente: local | homologacao | producao
AMBIENTE=local

# ---------------------------------------------------------
# Data Lake do Microsoft Fabric (lakehouse disktrans_gold) — só preencha
# se o projeto usar back/python/app/integracoes/fabric_gold.py. Ver
# docs/diretrizes-uso-datalake.md. Acesso via Service Principal do Entra
# ID, próprio deste projeto (nunca reaproveitar Service Principal de outra
# integração). Requer ODBC Driver 18 for SQL Server instalado na
# máquina/servidor onde a API roda. Se o projeto não usar o Data Lake,
# apague este bloco.
# ---------------------------------------------------------
# Directory (tenant) ID — overview do App Registration
FABRIC_TENANT_ID=coloque-o-tenant-id-aqui
# Application (client) ID — overview do App Registration
FABRIC_CLIENT_ID=coloque-o-client-id-aqui
# Client secret — Certificates & secrets > New client secret (copiar o "Value")
FABRIC_CLIENT_SECRET=coloque-o-client-secret-aqui
# Lakehouse > Configurações > SQL analytics endpoint
FABRIC_SQL_ENDPOINT=coloque-o-sql-endpoint-aqui
FABRIC_SQL_DATABASE=disktrans_gold
FABRIC_POOL_MAX_CONEXOES=5

# ---------------------------------------------------------
# Outras integrações do projeto (exemplos — remova o que não usar)
# ---------------------------------------------------------
# N8N_WEBHOOK_URL=
# API_TOKEN_TERCEIRO=
