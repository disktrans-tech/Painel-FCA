# Copie para ".env.local" e ajuste se necessário (o ".env.local" nunca é
# commitado — já está no .gitignore).
#
# Atenção: o Vite expõe ao navegador QUALQUER variável prefixada com
# VITE_ — ela vai parar no bundle público. Nunca coloque chave, token ou
# senha aqui, nem em nenhuma outra variável VITE_*. Segredo de verdade só
# no backend.

VITE_API_URL=http://localhost:8000
